{
  "name": "k8s-rig-readonly",
  "description": "Read-only Kubernetes state harvest for a kind cluster: list_resources / list_resource_names / get_resource (allowlisted kinds) + list_secret_names (metadata only, never values) + compare_declared_fields (differing declared field paths, never values; get only). Read-only by construction (verb-enum + RBAC). Out-of-policy calls return isError, not a throw. Rig service; static SA creds (not JWKS).",
  "endpoint": "https://k8s-lab.paichart.app/mcp",
  "category": "automation",
  "capabilities": {
    "tools": [
      {
        "name": "list_resources",
        "description": "List a resource KIND in a namespace (read-only).",
        "inputSchema": {
          "type": "object",
          "required": [
            "resourceType",
            "namespace"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "pods",
                "services",
                "configmaps",
                "endpoints",
                "resourcequotas",
                "limitranges",
                "serviceaccounts",
                "deployments",
                "replicasets",
                "statefulsets",
                "daemonsets",
                "ingresses",
                "networkpolicies",
                "horizontalpodautoscalers",
                "poddisruptionbudgets"
              ]
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            },
            "labelSelector": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      },
      {
        "name": "list_resource_names",
        "description": "List a resource KIND's NAMES + labels + count in a namespace (read-only, metadata only — never specs). The cap-safe way to bound a population: list_resources returns full objects and truncates at the ~8 KB tool-result cap.",
        "inputSchema": {
          "type": "object",
          "required": [
            "resourceType",
            "namespace"
          ],
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "pods",
                "services",
                "configmaps",
                "endpoints",
                "resourcequotas",
                "limitranges",
                "serviceaccounts",
                "deployments",
                "replicasets",
                "statefulsets",
                "daemonsets",
                "ingresses",
                "networkpolicies",
                "horizontalpodautoscalers",
                "poddisruptionbudgets"
              ]
            },
            "namespace": {
              "type": "string"
            },
            "labelSelector": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "get_resource",
        "description": "Get a single namespaced resource (read-only).",
        "inputSchema": {
          "type": "object",
          "required": [
            "resourceType",
            "namespace",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "pods",
                "services",
                "configmaps",
                "endpoints",
                "resourcequotas",
                "limitranges",
                "serviceaccounts",
                "deployments",
                "replicasets",
                "statefulsets",
                "daemonsets",
                "ingresses",
                "networkpolicies",
                "horizontalpodautoscalers",
                "poddisruptionbudgets"
              ]
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            }
          }
        }
      },
      {
        "name": "list_secret_names",
        "description": "List Secret NAMES + key names in a namespace — metadata only, never values.",
        "inputSchema": {
          "type": "object",
          "required": [
            "namespace"
          ],
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            }
          }
        }
      },
      {
        "name": "compare_declared_fields",
        "description": "Compare a manifest file's DECLARED fields with the live objects it names (read-only: one get per object, no list, no patch). Returns per object the declared field PATHS whose live value differs — never a value. Undeclared fields are not read out. A Secret is never fetched. A kustomization, Helm values file or non-allowlisted kind is not-compared with a reason. redactedMarker: a declared string containing it is listed as redactedNotCompared.",
        "inputSchema": {
          "type": "object",
          "required": [
            "manifest"
          ],
          "additionalProperties": false,
          "properties": {
            "manifest": {
              "type": "string",
              "maxLength": 262144
            },
            "defaultNamespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 253
            },
            "redactedMarker": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64
            }
          }
        }
      }
    ]
  }
}
