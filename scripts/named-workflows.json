    "name": "pov-status-report",
    "description": "Generate and send a POV status report to stakeholders.\n\nWHAT IT DOES:\n1. Lists all active POVs (IN_PROGRESS status)\n2. Gets detailed information for the first POV found\n3. Sends a summary email notification to the team\n\nWHEN TO USE:\n- Weekly status updates to management\n- Client meeting preparation\n- Portfolio health check\n\nVARIABLE CHAINING:\n- Step 2 uses {{step.0.output.data[0].id}} to get POV details\n- Step 3 uses {{step.1.output.title}} for the email subject\n\nEXAMPLE:\nservices({ action: \"workflow.execute\", workflowName: \"pov-status-report\" })",
    "category": "reporting",
    "status": "ACTIVE",
    "steps": {
      "steps": [
        {
          "tool": "project",
          "service": "paichart-project-service",
          "arguments": {
            "limit": 10,
            "action": "pov.list",
            "status": "IN_PROGRESS"
          }
        },
        {
          "tool": "project",
          "service": "paichart-project-service",
          "arguments": {
            "povId": "{{step.0.output.data[0].id}}",
