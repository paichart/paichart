[
  {
    "name": "blocked-task-escalation",
    "description": "Find blocked tasks and send escalation notifications.\n\nWHAT IT DOES:\n1. Lists all tasks with BLOCKED status\n2. Sends escalation notification chain (email -> slack after delay)\n\nWHEN TO USE:\n- Daily standup preparation\n- Bottleneck identification\n- Proactive issue resolution\n\nESCALATION PATH:\n- Immediate: Email to task owner\n- After 30 min: Slack to team channel\n\nEXAMPLE:\nservices({ action: \"workflow.execute\", workflowName: \"blocked-task-escalation\" })",
    "category": "automation",
    "status": "ACTIVE",
    "steps": {
      "steps": [
        {
          "tool": "project",
          "service": "paichart-project-service",
          "arguments": {
            "limit": 20,
            "action": "task.list",
            "status": "BLOCKED"
          }
        },
        {
          "tool": "escalate",
          "service": "notification-service",
          "arguments": {
            "message": {
              "body": "Found {{step.0.output.totalCount}} blocked tasks requiring attention.",
              "subject": "Blocked Tasks Alert",
              "priority": "high"
            },
            "escalationPath": [
              {
                "channel": "email",
                "recipients": [
                  {
                    "id": "owner",
                    "address": "owner@company.com"
                  }
                ],
                "delayMinutes": 0
              },
              {
                "channel": "slack",
                "recipients": [
                  {
                    "id": "team",
                    "address": "#project-alerts"
                  }
                ],
                "delayMinutes": 30
              }
            ],
            "maxEscalations": 3
          },
          "dependsOn": [
            0
          ]
        }
      ],
      "timeout": 45000,
      "executionMode": "sequential",
      "failureStrategy": "continue"
    },
    "triggers": {},
    "schedule": null,
    "createdBy": null
  },
