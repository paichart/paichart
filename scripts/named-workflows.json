  {
    "name": "task-completion-notify",
    "description": "Mark a task complete and notify the team.\n\nWHAT IT DOES:\n1. Gets full task context (details, history, dependencies)\n2. Updates task status to COMPLETED\n3. Broadcasts notification to email and Slack\n\nWHEN TO USE:\n- Automated task completion workflows\n- Milestone achievement announcements\n- Team celebration triggers\n\nREQUIRES:\n- taskId parameter (or uses first task from recent list)\n\nEXAMPLE:\nservices({ action: \"workflow.execute\", workflowName: \"task-completion-notify\", taskId: \"cm...\" })",
    "category": "automation",
    "status": "ACTIVE",
    "steps": {
      "steps": [
        {
          "tool": "project",
          "service": "paichart-project-service",
          "arguments": {
            "limit": 1,
            "action": "task.list",
            "status": "IN_PROGRESS"
          }
        },
        {
          "tool": "project",
          "service": "paichart-project-service",
          "arguments": {
            "action": "task.context",
            "taskId": "{{step.0.output.data[0].id}}",
            "includeHistory": true
          },
          "dependsOn": [
            0
          ]
        },
        {
          "tool": "perform",
          "service": "paichart-project-service",
          "arguments": {
            "action": "task.complete",
            "taskId": "{{step.0.output.data[0].id}}",
            "parameters": {
              "completionNotes": "Completed via workflow automation"
            }
          },
          "dependsOn": [
            1
          ]
        },
        {
          "tool": "broadcast",
          "service": "notification-service",
          "arguments": {
            "message": {
              "body": "Task \"{{step.1.output.task.title}}\" has been marked complete.\n\nPOV: {{step.1.output.pov.title}}\nPhase: {{step.1.output.phase.name}}",
              "subject": "Task Completed: {{step.1.output.task.title}}",
              "priority": "normal"
            },
            "channels": [
              "email",
              "slack"
            ],
            "recipients": {
              "email": [
                {
                  "id": "team",
                  "address": "team@company.com"
                }
              ],
              "slack": [
                {
                  "id": "channel",
                  "address": "#project-updates"
                }
              ]
            }
          },
          "dependsOn": [
            2
          ]
        }
      ],
      "timeout": 60000,
      "executionMode": "sequential",
      "failureStrategy": "rollback"
    },
    "triggers": {},
    "schedule": null,
    "createdBy": null
  },
