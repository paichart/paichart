  {
    "name": "daily-energy-weather",
    "description": "daily-operational-snapshot runs a coordinated multi-service pull of the latest grid and weather intelligence for Texas.\nIt retrieves current generation mix, capacity, and utilization from EIA alongside real-time conditions and a 5-day forecast.\nThe workflow correlates infrastructure status with weather drivers to identify operational risk or optimization windows.\nOutputs support daily decisions on maintenance timing, dispatch posture, and energy-intensive scheduling.",
    "category": "general",
    "status": "ACTIVE",
    "steps": {
      "steps": [
        {
          "tool": "get_generation_mix_by_state",
          "service": "eia-service",
          "arguments": {
            "state": "TX",
            "period": "latest"
          },
          "dependsOn": []
        },
        {
          "tool": "get_capacity_utilization_by_state",
          "service": "eia-service",
          "arguments": {
            "state": "TX",
            "season": "both"
          },
          "dependsOn": []
        },
        {
          "tool": "current_weather",
          "service": "weather-service",
          "arguments": {
            "units": "imperial",
            "location": "Austin,US"
          },
          "dependsOn": []
        },
        {
          "tool": "forecast",
          "service": "weather-service",
          "arguments": {
            "days": 5,
            "units": "imperial",
            "location": "Austin,US"
          },
          "dependsOn": []
        }
      ],
      "timeout": 180000,
      "executionMode": "sequential",
      "failureStrategy": "stop"
    },
    "triggers": {
      "manual": true
    },
    "schedule": null,
    "createdBy": null
  },
