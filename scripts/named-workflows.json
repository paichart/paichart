    "category": "onboarding",
    "status": "ACTIVE",
    "steps": {
      "steps": [
        {
          "tool": "verify_auth",
          "retries": 0,
          "service": "token-validator-service",
          "arguments": {},
          "retryDelay": 2000
        },
        {
          "tool": "list_objects",
          "retries": 0,
          "service": "Snowflake Service",
          "arguments": {
            "objectType": "databases"
          },
          "retryDelay": 2000
        }
      ],
      "timeout": 30000,
      "requires": [
        "povId"
