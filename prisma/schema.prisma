generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  theatre   SalesTheatre
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  povs      POV[]
  regions   Region[]
  preferredUsers User[] @relation("UserPreferredCountry", map: "UserPreferredCountry")

  @@index([theatre])
}

model Region {
  id        String      @id @default(cuid())
  name      String
  type      RegionType?  // Optional: Allows custom region names without forced directional types
  countryId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  povs      POV[]
  country   Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
 preferredUsers User[]  @relation("UserPreferredRegion", map: "UserPreferredRegion")

  @@unique([type, countryId])  // Null values ignored in unique constraint (Prisma behavior)
  @@index([countryId])
}

model POV {
  id              String           @id @default(cuid())
  title           String           @db.VarChar(500)
  description     String
  status          POVStatus        @default(PROJECTED)
  priority        Priority         @default(MEDIUM)
  startDate       DateTime
  endDate         DateTime
  objective       String?
  dealId          String?
  opportunityName String?
  revenue         Decimal?
  forecastDate    DateTime?
  customerName    String?
  customerContact String?
  partnerName     String?
  partnerContact  String?
  competitors     String[]
  solution        String?
  lastCrmSync     DateTime?
  crmSyncStatus   String?
  documents       Json?
  featureRequests Json?
  supportTickets  Json?
  blockers        Json?
  tags            String[]
  estimatedBudget Decimal?
  budgetDocument  String?
  resources       Json?
  salesTheatre    SalesTheatre
  countryId       String
  regionId        String?
  ownerId         String
  teamId          String?          @unique  // 1:1 with Team — enforced 2026-05-17 (audit Finding #12)
  templateId      String?
  formData        Json?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  syncHistory     CRMSyncHistory[]
  milestones      Milestone[]
  country         Country          @relation(fields: [countryId], references: [id])
  owner           User             @relation("POVOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  region          Region?          @relation(fields: [regionId], references: [id])
  team            Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template        POVTemplate?     @relation("POVFromTemplate", fields: [templateId], references: [id])
  kpis            POVKPI[]
  launch          POVLaunch?
  phases          Phase[]
  workflows       Workflow[]
  tasks           Task[]
  
  // MCP Integration Relationships
  mcpInteractions MCPInteraction[]
  mcpRecommendations MCPRecommendation[]
  workflowExecutions MCPWorkflowExecution[]

  @@index([status, priority])
  @@index([ownerId])
  @@index([teamId])
  @@index([lastCrmSync])
  @@index([countryId])
  @@index([regionId])
  @@index([salesTheatre])
  @@index([templateId])
}

model POVTemplate {
  id          String    @id @default(cuid())
  name        String
  description String
  version     String?
  status      String    @default("draft")
  schema      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  povs        POV[]     @relation("POVFromTemplate")
}

model PhaseTemplate {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(255)
  description String?
  type        PhaseType @default(PLANNING)
  isDefault   Boolean   @default(false)
  workflow    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  phases      Phase[]
}

model Phase {
  id          String         @id @default(cuid())
  name        String
  description String
  type        PhaseType      @default(PLANNING)
  startDate   DateTime
  endDate     DateTime
  order       Int
  povId       String
  templateId  String?
  details     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pov         POV            @relation(fields: [povId], references: [id], onDelete: Cascade)
  template    PhaseTemplate? @relation(fields: [templateId], references: [id])
  stages      Stage[]
  tasks       Task[]

  @@index([povId])
  @@index([templateId])
  @@index([startDate, endDate])
}

model Stage {
  id          String          @id @default(cuid())
  phaseId     String
  name        String
  description String?
  status      StageStatus     @default(PENDING)
  order       Int
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  phase       Phase           @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tasks       Task[]
  activities  StageActivity[]

  @@index([phaseId])
  @@index([status])
  @@map("stages")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String   @map("task_id")
  filename   String
  fileSize   Int      @map("file_size")
  fileType   String   @map("file_type")
  storageUrl String   @map("storage_url")
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  action    String
  timestamp DateTime @default(now())

  // Rich activity details (2025-12-31 - 9 specialists, 88% confidence)
  // @see /cline_docs/reviews/task-activity-rich-details-2025-12-31/
  details   Json?    // Structured activity data (assignee names, old/new values, agent info)
  metadata  Json?    // Audit trail (source, IP, user agent, request ID)

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])                // P0 Fix: Optimize task activity queries (Issue #5)
  @@index([userId])                // P0 Fix: Optimize user activity queries (Issue #5)
  @@index([timestamp])             // P0 Fix: Optimize recent activity queries (Issue #5)
  @@index([taskId, timestamp])     // P0 Fix: Optimize task history queries (Issue #5)
  @@map("task_activities")
}

// Mirrors TaskActivity for stage-level audit trail (added 2026-04-26).
// Forensic capability for harness clobber-detection investigations and
// general stage lifecycle tracing. Phase 1 schema only — wiring lands
// separately. Empty until Phase 2 instruments stage write sites.
model StageActivity {
  id        String   @id @default(cuid())
  stageId   String   @map("stage_id")
  userId    String   @map("user_id")
  action    String
  timestamp DateTime @default(now())

  details   Json?
  metadata  Json?

  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stageId])
  @@index([userId])
  @@index([timestamp])
  @@index([stageId, timestamp])
  @@map("stage_activities")
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())
  
  // Relations
  task        Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  
  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  assigneeId  String?        @map("assignee_id")
  teamId      String?        @map("team_id")
  povId       String?        @map("pov_id")
  phaseId     String?        @map("phase_id")
  stageId     String?        @map("stage_id")
  order       Int            @default(0)
  dueDate     DateTime?      @map("due_date")
  priority    TaskPriority   @default(MEDIUM)
  status      TaskStatus     @default(OPEN)
  type        TaskType       @default(ACTION) // New field for task type enum
  metadata    Json?
  
  // AI-Driven Development Fields
  agentRole       String?
  prompt          String?        @db.Text
  inputContext    Json?
  outputArtifacts Json?
  executionStatus ExecutionStatus?
  agentLog        String?        @db.Text
  /// ⚠️ CARRIED BUT NOT CONSUMED by agent execution (verified 2026-08-05). This value is read into the
  /// execution config (agentExecutionConfigBuilder, agentExecutionEngine, agentTaskService) and nothing
  /// downstream ever loops on it — no code in lib/agents/harness/ or execution-core reads it back.
  /// The retries that DO happen are each hard-bounded to ONE and never consult it: the truncation retry
  /// (agentic-tool-loop maybeRetryTruncatedFullTurn) and the 50-69 diagnostic retry (harness/diagnostic-retry).
  /// The real maxRetries loop lives in the HUB's workflowEngine (its own executionConfig) — do not
  /// mistake one for the other. Wiring this up is a feature, not a fix: an agent-level retry produces a
  /// RIVAL artifact, so it would have to route through keep-best supersession (execution-selection.ts)
  /// or a degraded re-run could silently win. See cline_docs/learning/11-when-a-judgment-may-be-believed.md §7.
  maxRetries      Int?           @default(3)
  timeout         Int?
  
  // Agent Template Integration
  agentTemplateId String?
  agentTemplate   AgentTemplate? @relation("TaskAgentTemplate", fields: [agentTemplateId], references: [id])
  
  // MCP Integration Fields
  mcpContext      Json?             // MCP tool context and metadata
  mcpToolId       String?           // Associated MCP tool identifier
  mcpWorkflowId   String?           // MCP workflow execution ID
  mcpMetadata     Json?             // MCP-specific metadata
  
  // Parent-Child Relationship
  parentTaskId    String?
  parentTask      Task?          @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks        Task[]         @relation("SubTasks")
  
  // Dependency Relationships
  dependencies    TaskDependency[] @relation("TaskDependencies")
  dependents      TaskDependency[] @relation("TaskDependents")
  
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  completedAt DateTime?      @map("completed_at") // Set at the status→COMPLETED transition (taskCompletedAtExtension); real completion time vs the updatedAt proxy
  attachments Attachment[]
  comments    Comment[]
  activities  TaskActivity[]
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  phase       Phase?         @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  pov         POV?           @relation(fields: [povId], references: [id], onDelete: Cascade)
  stage       Stage?         @relation(fields: [stageId], references: [id], onDelete: SetNull)
  team        Team?          @relation(fields: [teamId], references: [id])
  executions  AgentExecution[]
  
  // MCP Integration Relationships
  mcpInteractions MCPInteraction[]
  mcpRecommendations MCPRecommendation[]

  @@index([stageId])
  @@index([executionStatus])
  @@index([parentTaskId])
  @@index([povId, status])         // P0 Fix: Optimize POV-scoped task queries (Issue #5)
  @@index([assigneeId, status])    // P0 Fix: Optimize user task queries (Issue #5)
  @@index([phaseId, status])       // P0 Fix: Optimize phase task queries (Issue #5)
  @@index([povId, status, assigneeId], name: "idx_task_pov_status_assignee") // Q1 2026 Performance: POV task filtering by assignee + status
  @@index([assigneeId, status, updatedAt], name: "idx_task_assignee_status_updated") // Phase 1.5: Stale task detection queries
  @@index([status, dueDate], name: "idx_task_status_duedate") // Phase 1.5: Approaching deadline queries
  // 2026-04-18 A6: Partial JSONB expression index `idx_tasks_pipeline_stage_id`
  // on ((metadata->>'pipelineStageId')) WHERE type = 'PIPELINE' accelerates
  // harness-to-child lookups in the reactor (pipelineRetriggerReactorService.ts:111,
  // agentExecutionConfigBuilder.ts:190) and the pipeline-context API endpoint.
  // Prisma cannot express partial JSONB expression indexes; applied via raw SQL
  // per the sanctioned db-push exception. Ops script:
  //   scripts/create-tasks-pipeline-stage-jsonb-index.sh
  // Plan: cline_docs/reviews/pipeline-context-a6-2026-04-18/implementation-plan.md §Phase 1
  // Pattern: .claude/knowledge/patterns/database-drift-elimination-pattern.md
  @@map("tasks")
}

model AgentExecution {
  id              String          @id @default(cuid())
  taskId          String
  agentTemplateId String?
  status          String
  config          Json
  context         Json
  logs            String[]
  startTime       DateTime?
  endTime         DateTime?
  // token-usage-persistence Phase 1 (2026-07-02): structured LLM token FACTS. Cost is derived on
  // read from a time-versioned pricing table (Protocol 10 fact-vs-verdict), never stored. All
  // nullable — populated at the terminal update for executions that ran an LLM call; forward-only
  // (historical rows stay null; they lack the input/output/cache split and were prune-capped).
  inputTokens          Int?
  outputTokens         Int?
  cacheReadTokens      Int?
  cacheCreationTokens  Int?
  modelUsed            String?    // serving model (a fallback rescue reports the model that answered)
  /// Branchable failure code — the same value written as error.json `errorCategory`, from the same
  /// input in the same terminal transaction (execution-terminal-persist.ts), so the two cannot drift.
  /// Nullable + forward-only (historical rows stay null; retention ages them out within days, so a
  /// backfill would be work the pruner deletes). `null` means "no code recorded" — never synthesize
  /// a placeholder like 'UNKNOWN' (that would be a verdict an agent branches on wrongly, Protocol 10).
  /// String, not enum: codes are open-ended and site-authored, and an unknown code must never become
  /// a WRITE FAILURE on the failure path. Matches `status`, also a plain String.
  /// No index: nothing filters on it today (adding one is the redundant-index smell).
  /// Panel: cline_docs/reviews/agent-error-code-surface-2026-07-25/SYNTHESIS.md §2
  errorCode            String?
  // retry-band keep-best (2026-07-04, reviewed 92%): SELF-supersession mark. Set by the completing
  // execution ON ITS OWN ROW, synchronously, inside its terminal tx, when it is an orchestrator
  // retry (context.reExecutionOfExecutionId present) whose facts show catastrophic degradation vs
  // its target (conjunctive rule — see execution-selection.ts). Points at the execution it lost to
  // (forensic provenance, NOT a live FK — the winner may be pruned later; never model as a relation).
  // Selection: authoritative consumers filter supersededById IS NULL via selectAuthoritativeExecution.
  // Partial index idx_agent_executions_authoritative_per_task (raw SQL — Prisma can't express partial
  // indexes): ops script scripts/create-authoritative-execution-index.sh, applied automatically by
  // scripts/apply-raw-sql-indexes.sh (wired into production-deploy.yml after db push; idempotent).
  // Same sanctioned db-push exception as idx_agent_executions_active_per_task below.
  supersededById       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  task            Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentTemplate   AgentTemplate?  @relation("ExecutionAgentTemplate", fields: [agentTemplateId], references: [id])
  artifacts       AgentArtifact[]

  @@index([taskId])
  @@index([agentTemplateId])
  @@index([status])
  @@index([startTime])             // P0 Fix: Optimize date-range queries (Issue #5)
  @@index([modelUsed, startTime])  // token-usage: spend-per-serving-model-over-time (the primary metric)
  // 2026-04-18 L3: Partial UNIQUE index `idx_agent_executions_active_per_task`
  //
  // token-usage-persistence Phase 2 #1: the token columns above are rolled up into TokenUsageDaily
  // (below) by rollUpBeforeDelete() at the 3 delete sites BEFORE these rows are pruned — durable
  // cost history survives PRUNE-ON-COMPLETE.
  // on (taskId) WHERE status IN ('PENDING','RUNNING') enforces "one active
  // execution per task" at the DB level. Prisma cannot express partial unique
  // indexes in schema, so it is applied via raw SQL per the sanctioned
  // db-push exception. Ops script:
  //   scripts/create-agent-execution-active-unique-index.sh
  // Plan: cline_docs/reviews/agent-execute-race-condition-2026-04-18/implementation-plan.md §5.B
  // Pattern: .claude/knowledge/patterns/database-drift-elimination-pattern.md
  @@map("agent_executions")
}

/// token-usage-persistence Phase 2 #1 (2026-07-02): durable daily token-cost history.
/// Token FACTS are rolled up here from `agent_executions` by `rollUpBeforeDelete()` at the 3 delete
/// sites BEFORE those rows are pruned (PRUNE-ON-COMPLETE + resourceManager cleanups), so cost history
/// is durable and unbounded. Cost is DERIVED on read (never stored — Protocol 10; the row holds only
/// token facts + model + date, so `costForExecution(sum, modelUsed, bucketDate)` still applies).
///
/// COMPOSITE PK (deviates from the surrogate-cuid convention, deliberately): this is a pure aggregate
/// with no FK/resource exposure — the natural key IS the identity, and it lets the raw
/// `INSERT … ON CONFLICT (povId, bucketDate, modelUsed) DO UPDATE` increment target the PK directly
/// (no cuid-in-raw-SQL problem; no cuid generator is bundled). NULLs are impossible by construction:
/// `povId`/`modelUsed` carry `__none__`/`__unknown__` sentinels, because Postgres treats NULL as
/// distinct in a key and would silently break the upsert-increment.
model TokenUsageDaily {
  povId                String   // POV of the execution's task, or '__none__' sentinel (admin-only bucket)
  bucketDate           DateTime @db.Date  // UTC day of execution.startTime — NOT the prune date
  modelUsed            String   // serving model, or '__unknown__' sentinel
  executions           BigInt   @default(0)
  inputTokens          BigInt   @default(0)
  outputTokens         BigInt   @default(0)
  cacheReadTokens      BigInt   @default(0)
  cacheCreationTokens  BigInt   @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@id([povId, bucketDate, modelUsed])
  @@index([modelUsed, bucketDate])  // admin cross-POV: spend-per-model-over-time
  @@map("token_usage_daily")
}

model AgentArtifact {
  id          String         @id @default(cuid())
  executionId String
  name        String
  type        String
  content     String
  createdAt   DateTime       @default(now())
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@map("agent_artifacts")
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  pov       POV?         // 1:0..1 with POV — paired with POV.teamId @unique (2026-05-17 audit Finding #12)
  members   TeamMember[]
  tasks     Task[]
}

model KPITemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          KPIType
  isCustom      Boolean  @default(false)
  defaultTarget Json?
  calculation   String?
  visualization String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  kpis          POVKPI[]
}

model AgentTemplate {
  id              String            @id @default(cuid())
  name            String
  description     String?
  category        AgentCategory     @default(GENERAL)
  templateType    TemplateType?     // Functional role: how this template approaches work

  // Agent Configuration
  defaultRole     String            // Default agent role (e.g., "Senior Developer", "QA Engineer")
  promptTemplate  String            @db.Text // Template for agent prompts with placeholders
  capabilities    Json              // Agent capabilities and skills
  constraints     Json              // Agent constraints and limitations
  
  // Execution Configuration
  /// ⚠️ CARRIED BUT NOT CONSUMED by agent execution (verified 2026-08-05). This value is read into the
  /// execution config (agentExecutionConfigBuilder, agentExecutionEngine, agentTaskService) and nothing
  /// downstream ever loops on it — no code in lib/agents/harness/ or execution-core reads it back.
  /// The retries that DO happen are each hard-bounded to ONE and never consult it: the truncation retry
  /// (agentic-tool-loop maybeRetryTruncatedFullTurn) and the 50-69 diagnostic retry (harness/diagnostic-retry).
  /// The real maxRetries loop lives in the HUB's workflowEngine (its own executionConfig) — do not
  /// mistake one for the other. Wiring this up is a feature, not a fix: an agent-level retry produces a
  /// RIVAL artifact, so it would have to route through keep-best supersession (execution-selection.ts)
  /// or a degraded re-run could silently win. See cline_docs/learning/11-when-a-judgment-may-be-believed.md §7.
  maxRetries      Int               @default(3)
  timeout         Int               @default(300) // seconds
  priority        AgentPriority     @default(MEDIUM)
  
  // Context and Metadata
  inputSchema     Json?             // Expected input schema
  outputSchema    Json?             // Expected output schema
  contextTemplate Json?             // Template for context generation
  metadata        Json?             // Additional template metadata
  
  // Template Management
  version         String            @default("1.0.0")
  status          AgentTemplateStatus @default(ACTIVE)
  isDefault       Boolean           @default(false)
  tags            String[]
  
  // Usage and Performance
  usageCount      Int               @default(0)
  successRate     Float?            // Success rate percentage
  averageTime     Float?            // Average execution time
  
  // Relationships
  tasks           Task[]            @relation("TaskAgentTemplate")
  executions      AgentExecution[]  @relation("ExecutionAgentTemplate")
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?

  @@index([category])
  @@index([templateType])
  @@index([status])
  @@index([isDefault])
  @@index([category, status], name: "idx_agent_template_category_status") // Q1 2026 Performance: Filter active templates by category
  @@map("agent_templates")
}

model AgentPromptLibrary {
  id              String            @id @default(cuid())
  name            String            @unique
  description     String?
  category        AgentCategory
  
  // Prompt Configuration
  promptText      String            @db.Text
  variables       Json              // Available variables and their types
  examples        Json              // Example inputs and outputs
  
  // Usage Context
  useCase         String            // Specific use case description
  complexity      AgentComplexity   @default(MEDIUM)
  estimatedTime   Int?              // Estimated execution time in seconds
  
  // Quality and Performance
  rating          Float?            // User rating 1-5
  usageCount      Int               @default(0)
  successRate     Float?
  
  // Template Management
  version         String            @default("1.0.0")
  status          AgentTemplateStatus @default(ACTIVE)
  isPublic        Boolean           @default(false)
  tags            String[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?

  @@index([category])
  @@index([complexity])
  @@index([status])
  @@index([isPublic])
  @@map("agent_prompt_library")
}

model POVKPI {
  id         String       @id @default(cuid())
  povId      String
  templateId String?
  name       String
  target     Json
  current    Json
  history    Json         @default("[]")
  weight     Float?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  pov        POV          @relation(fields: [povId], references: [id], onDelete: Cascade)
  template   KPITemplate? @relation(fields: [templateId], references: [id])

  @@index([povId])
  @@index([templateId])
}

model CRMSyncHistory {
  id        String   @id @default(cuid())
  povId     String
  status    String
  details   Json?
  createdAt DateTime @default(now())
  pov       POV      @relation(fields: [povId], references: [id], onDelete: Cascade)

  @@index([povId])
  @@index([createdAt])
}

model POVLaunch {
  id         String    @id @default(cuid())
  povId      String    @unique
  confirmed  Boolean   @default(false)
  checklist  Json
  launchedAt DateTime?
  launchedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pov        POV       @relation(fields: [povId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String          @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime
  povId       String
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  pov         POV             @relation(fields: [povId], references: [id], onDelete: Cascade)

  @@index([povId])
  @@index([dueDate])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])   // Phase 0: POV validation performance (50-100ms → 2-5ms)
  @@index([teamId])   // Phase 0: Team-based query performance
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_activity_user_timeline") // Q1 2026 Performance: User activity timeline (DESC order optimized)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   @default("info")
  actionUrl String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])          // P0 Fix: Optimize unread notification queries (Issue #5)
  @@index([userId, createdAt])     // P0 Fix: Optimize recent notification queries (Issue #5)
  @@map("notifications")
}

model RefreshToken {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String

  // OAuth 2.0 fields (Restart resilience - TODO design)
  scope           String?  // OAuth scope (e.g., "read:user read:org")
  audience        String?  // Token audience (Component 5)
  clientId        String?  // OAuth client ID (chatgpt, claude-desktop, gemini)

  // Security fields (Session validation - Fix 8 design)
  provider        String?  // OAuth provider (github/microsoft/google)
  sessionMetadata Json?    // Session tracking (IP, user-agent, suspicious activity)

  createdAt       DateTime @default(now())
  expiresAt       DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, clientId])  // Per-client session tracking
  @@index([userId, provider])  // Per-provider session tracking
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
