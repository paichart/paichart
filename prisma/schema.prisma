// MCP (Model Context Protocol) Integration Models

model MCPTool {
  id              String            @id @default(cuid())
  name            String
  description     String?
  version         String
  capabilities    Json              // Tool capabilities and supported operations
  configuration   Json              // Tool configuration and settings
  status          MCPToolStatus     @default(ACTIVE)
  
  // Authentication and Security
  authType        MCPAuthType       @default(API_KEY)
  credentials     Json              // Encrypted credentials
  permissions     Json              // Tool permissions and access levels
  
  // Performance and Monitoring
  lastHeartbeat   DateTime?
  responseTime    Float?            // Average response time in ms
  successRate     Float?            // Success rate percentage
  errorCount      Int               @default(0)
  
  // Relationships
  interactions    MCPInteraction[]
  recommendations MCPRecommendation[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([name])
  // Phase A Performance: Composite indices for discovery queries (Dec 2025)
  @@index([status, responseTime, successRate], name: "mcp_discovery_performance")
  @@index([capabilities(ops: raw("jsonb_path_ops"))], type: Gin, name: "mcp_capability_search")
  // Note: category field doesn't exist in MCPTool model - using existing status index instead
  @@map("mcp_tools")
}

model MCPInteraction {
  id              String            @id @default(cuid())
  toolId          String
  taskId          String?
  povId           String?
  
  // Interaction Details
  action          MCPAction
  request         Json              // Original request payload
  response        Json?             // Tool response
  status          MCPInteractionStatus @default(PENDING)
  
  // Context and Metadata
  context         Json?             // Interaction context
  metadata        Json?             // Additional metadata
  executionTime   Int?              // Execution time in ms
  
  // Error Handling
  error           String?           // Error message if failed
  retryCount      Int               @default(0)
  maxRetries      Int               @default(3)

  // Relationships
  tool            MCPTool           @relation(fields: [toolId], references: [id], onDelete: Cascade)
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  pov             POV?              @relation(fields: [povId], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([toolId])
  @@index([taskId])
  @@index([povId])
  @@index([status])
  @@index([action])
  @@map("mcp_interactions")
}

model MCPWorkflow {
  id              String            @id @default(cuid())
  name            String            @unique  // Unique for lookup by name
  description     String?
  category        String?           // testing, deployment, analysis, automation
  createdBy       String?           // userId who created

  // Workflow Configuration
  // steps contains full config: { steps, executionMode, failureStrategy, timeout }
  steps           Json              // Workflow steps and configuration
  triggers        Json              // Workflow triggers and conditions
  schedule        Json?             // Scheduled execution configuration

  // Execution State
  status          MCPWorkflowStatus @default(ACTIVE)
  lastExecution   DateTime?
  nextExecution   DateTime?
  executionCount  Int               @default(0)

  // Performance Metrics
  successRate     Float?
  averageTime     Float?
  errorRate       Float?

  // Relationships
  executions      MCPWorkflowExecution[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([category])
  @@map("mcp_workflows")
}

model MCPWorkflowExecution {
  id              String            @id @default(cuid())

  // Workflow Reference (optional for ad-hoc)
  workflowId      String?           // NULLABLE for ad-hoc executions

  // Execution Identity
  userId          String            // Who triggered execution (REQUIRED)
  povId           String?           // POV scope (optional)
  executionMode   MCPExecutionMode  @default(AD_HOC)
  workflowType    String?           // e.g., 'mcp_service_orchestration'

  // Execution Details
  status          MCPWorkflowExecutionStatus @default(RUNNING)
  startTime       DateTime          @default(now())
  endTime         DateTime?
  duration        Int?              // Duration in ms

  // Execution Data
  input           Json?             // Input parameters
  output          Json?             // Execution results
  steps           Json?             // Step execution details (NULLABLE for incremental building)
  metadata        Json?             // Additional context

  // Error Handling
  error           String?           // Error message if failed
  failedStep      String?           // Step that failed

  // Relationships (with explicit onDelete behavior)
  workflow        MCPWorkflow?      @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  pov             POV?              @relation(fields: [povId], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Indexes (10 total - 3 existing + 7 new)
  @@index([workflowId])              // Existing
  @@index([userId])                  // NEW
  @@index([povId])                   // NEW
  @@index([executionMode])           // NEW
  @@index([workflowType])            // NEW
  @@index([status])                  // Existing
  @@index([startTime])               // Existing
  @@index([userId, status])          // NEW - dashboard queries
  @@index([povId, status])           // NEW - POV analytics
  @@map("mcp_workflow_executions")
}

model MCPRecommendation {
  id              String            @id @default(cuid())
  toolId          String
  taskId          String?
  povId           String?
  userId          String?           @map("user_id")

  // Recommendation Details
  type            MCPRecommendationType
  title           String
  description     String
  confidence      Float             // Confidence score 0-100 (integer range 60-95)
  impact          MCPImpact         // Expected impact level
  effort          MCPEffort         // Required effort level
  
  // Recommendation Data
  actions         Json              // Recommended actions
  parameters      Json              // Action parameters
  context         Json              // Recommendation context
  
  // Status and Tracking
  status          MCPRecommendationStatus @default(PENDING)
  implementedAt   DateTime?
  implementedBy   String?
  feedback        Json?             // Implementation feedback

  // Relationships
  tool            MCPTool           @relation(fields: [toolId], references: [id], onDelete: Cascade)
  task            Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  pov             POV?              @relation(fields: [povId], references: [id], onDelete: SetNull)
  user            User?             @relation("UserRecommendations", fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([toolId])
  @@index([taskId])
  @@index([povId])
  @@index([type])
  @@index([status])
  @@index([userId, toolId, status])  // Deduplication queries: find existing PENDING recs for user+tool
  @@map("mcp_recommendations")
}

