# pAIchart — local / self-host environment template
# cp .env.example .env  →  fill the REQUIRED section  →  npm run jwt:keys >> .env
# Every key here is read by the code (audited 2026-09-04). Production values are
# injected by the deploy workflow, never from this file.

############## REQUIRED ##############

# Postgres (empty DB is fine — `npx prisma db push` creates the schema, `npm run db:indexes` the raw-SQL indexes)
DATABASE_URL="postgresql://user:password@localhost:5432/paichart?pgbouncer=true&pool_timeout=5&connection_limit=3"

# Public base URL of THIS deployment. Drives OAuth issuer/resource metadata, callbacks, JWT audiences.
# Local: http://localhost:3000   Prod: https://your-domain
APP_BASE_URL="http://localhost:3000"

# RS256 signing keys — `npm run jwt:keys >> .env` appends JWT_PRIVATE_KEY_BASE64, JWT_PUBLIC_KEY_BASE64 and
# JWT_KEY_ID. They are deliberately NOT pre-set here: dotenv keeps the FIRST occurrence of a key, so a
# placeholder above the generated lines would silently win. (Found by the 2026-09-04 end-to-end run.)

# First account (SUPER_ADMIN), created by `npm run db:admin` / `db:seed`. Use it for administration only;
# make yourself an ADMIN in /admin/users for daily work. Leave ADMIN_PASSWORD unset to have one
# generated and printed ONCE (12+ chars, mixed classes, no common passwords — enforced).
ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD=

# OAuth state HMAC — any strong random string (e.g. `openssl rand -hex 32`)
OAUTH_STATE_SECRET="<openssl rand -hex 32>"

# At least one LLM provider (or set a key per user in Settings → LLM provider after login)
ANTHROPIC_API_KEY="your-anthropic-api-key"
DEFAULT_LLM_PROVIDER="anthropic"   # anthropic | gemini | ollama | custom

# Who may sign up, and as what. Both are SaaS-identical when unset (registration open, role DEMO_USER).
DEFAULT_USER_ROLE=USER          # USER = new sign-ups can create POVs / join teams (private install); DEMO_USER = public read-only viewer
ALLOW_REGISTRATION=true         # false = only administrators create accounts (/admin/users); closes /register AND OAuth first-login

############## OAUTH PROVIDERS (register your own apps; see docs/OAUTH-SETUP.md) ##############
# Web-app login providers. Callback URL for each: ${APP_BASE_URL}/api/auth/oauth/callback/<provider>
MICROSOFT_CLIENT_ID="your-azure-app-client-id"
MICROSOFT_CLIENT_SECRET="your-azure-app-client-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"

# MCP OAuth — ONE GitHub App for ALL MCP clients (proxy pattern: the server does the GitHub exchange).
# Callback: ${APP_BASE_URL}/oauth/callback  (the server's own — not per-client)
MCP_CLI_GITHUB_CLIENT_ID="your-org-github-app-client-id"
MCP_CLI_GITHUB_CLIENT_SECRET="your-org-github-app-client-secret"

############## OPTIONAL — sensible defaults if omitted ##############

# --- Key rotation (existing installs only; leave unset on a fresh install) ---
# Keep the previous pair for ~7 days so tokens it signed still verify. See scripts/generate-jwt-keys.sh.
# JWT_PUBLIC_KEY_PREV_BASE64=
# JWT_KEY_ID_PREV=
# JWT_KEY_PREV_EXPIRES=2026-01-01T00:00:00Z
# JWT_ACCESS_EXPIRATION=15      # minutes
# JWT_REFRESH_EXPIRATION=7      # days

# --- Artifact download links (HMAC-signed, 1h TTL). Dev falls back to a fixed key; prod REQUIRES it ---
# ARTIFACT_SIGNING_KEY=<openssl rand -hex 32>

# --- Internal URL the MCP server uses to reach the web server (same box) ---
# APP_INTERNAL_BASE_URL=http://127.0.0.1:3000

# --- MCP HTTP server (second process: `npm run mcp:http:dev`) ---
MCP_HTTP_PORT=8080
MCP_HTTP_CORS_ORIGIN=*
# MCP_HTTP_BIND_ALL=false        # true = bind 0.0.0.0 (behind a reverse proxy only)
MCP_SESSION_TIMEOUT=3600000      # ms
MCP_RETRY_ATTEMPTS=3
# MCP_ADMIN_EMAIL / MCP_ADMIN_PASSWORD — session-auth fallback when no API key; optional
# PAICHART_API_KEY=              # an RS256 first-party token for Claude Desktop (mint via API Keys UI after login)

# --- OAuth audit log (dir must be under /var/log/, /tmp/ or /var/www/) ---
OAUTH_LOG_DIR=/tmp/paichart-logs
OAUTH_LOG_LEVEL=info

# --- Transactional email (registration verification, password reset) via Brevo. Optional locally ---
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=noreply@example.com
# BREVO_FROM_NAME="pAIchart"

# --- Logging ---
# LOG_LEVEL=info                 # pino level (default: info in prod, debug in dev)

# --- Harness output guards (network-provisioning R9/R10). SAFE local default is off; prod runs both ON.
#     Env-var only, read at start — restart to change. Ref: .claude/knowledge/domain/harness/harness-output-guards.md ---
CONNECTED_OUTPUT_SANITIZE_ENABLED=false   # R9: neutralize untrusted connected-service output before the reasoner reads it
ARTIFACT_SECRET_REDACT_ENABLED=false      # R10: redact secrets from persisted report.md/result.json (enable for k8s/cloud engagements)

NODE_ENV="development"

# Never commit .env. Use different credentials per environment. Rotate regularly.
