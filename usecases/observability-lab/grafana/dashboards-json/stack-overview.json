{
  "uid": "stack-overview",
  "title": "Stack Overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Targets up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "count(up == 1)" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "up by job",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}}/{{instance}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Scrape duration (s)",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "scrape_duration_seconds", "legendFormat": "{{job}}" } ]
    }
  ]
}
