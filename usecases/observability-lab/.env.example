# Copy to `.env` beside docker-compose.yml and set both. Compose fails loudly if either is unset —
# that is deliberate: a lab that silently starts on a default password is how a "lab-only" credential
# ends up somewhere it was never meant to be.

# Grafana's initial admin password. Grafana forces a change at first GUI login; the harvest service
# does NOT follow that change, which is why it uses its own account below.
GRAFANA_ADMIN_PASSWORD=change-me

# Password for the dedicated read-only `obs-harvest` Grafana service account the MCP service
# authenticates as. Deliberately DECOUPLED from the human admin login — when an operator changed the
# admin password at first login, an inherited-credential design broke the harvest mid-run.
OBS_HARVEST_PASSWORD=change-me-too
